;==================================================
;311,拥抱（首次用 FIRSTTIME 演示）
;==================================================
@M_KOJO_SUCCESS_COM_K6_311
TFLAG:192 = 0

@M_KOJO_MESSAGE_COM_K6_311
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K6_311_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_311_1
LOCAL = 1
IF LOCAL
	;-------------------------------------------------
	;初次（FIRSTTIME 子开关）
	LOCAL:1 = 1
	;-------------------------------------------------
	IF LOCAL:1 && FIRSTTIME(SELECTCOM)
		;@AT 待手动测试 K6_311_初回
		PRINTFORML 「诶——、诶诶！？抱、抱过来了！？」
		PRINTFORMW （这是露娜第一次被人这样抱住。她僵在原地，慌得连消音都忘了，心跳声大得两个人都听得见。）
		RETURN 1
	ENDIF
	IF FLAG:時間停止
	ELSEIF TALENT:6:恋人
		;@AT 待自动测试 K6_311_恋人
		PRINTFORMW 「嘿嘿，抱紧点也没关系哦……反正声音我都消掉了，就算撒娇，也没人会知道。」
	ELSEIF TALENT:6:恋慕
		;@AT 待自动测试 K6_311_恋慕
		PRINTFORMW 「呜、呜哇，这么用力……心、心跳都要乱掉了啦……！」
	ELSE
		;@AT 待自动测试 K6_311_中立
		PRINTFORML 「放、放开我啦！妖精是不需要抱抱的！」
		PRINTFORMW （话虽如此，她挣扎的力道，却小得几乎可以忽略。）
	ENDIF
ENDIF
RETURN 1

