@M_KOJO_MESSAGE_COM_K6_300
;=== AUTOTEST 钩子（临时；发布前请注释本段 + 删 AUTOTEST.ERB + 删 autotest.txt）===
;  开关＝本口上目录 autotest.txt 的【内容】：on=启用 / off=禁用（与存档完全无关——正是想要的）。
;  会話时读它：内容含 on 就跑一次测试套件；套件结尾 SAVETEXT 把它写回 off（自动关、避免重复）。
;  玩家默认没有 autotest.txt 或内容为 off → LOADTEXT 失败/非on → 永不触发（对玩家安全）。
;  ⚠SAVETEXT/LOADTEXT：路径相对游戏根、【必须用正斜杠 /】、限 .txt（emuera.config 白名单）。
LOADTEXT "ERB/口上・メッセージ関連/個人口上/006 Luna [ルナ]/露娜切露德_重制/autotest.txt"
IF RESULT && STRCOUNT(RESULTS, "on")
	CALL M_KOJO_K6_AUTOTEST
	RETURN 1
ENDIF
;=== end AUTOTEST 钩子 ===
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K6_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_300_1
#DIM pool, 16
;-------------------------------------------------
;记入检查（=0 不显示，1 显示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	;--- 覆盖状态：这些是「压过一切」的特殊态，仍走排他判定 ---
	IF FLAG:時間停止
		;@AT 测试通过 K6_300_時停
		PRINTFORMW （静止的时间里，露娜维持着抱怨到一半的表情，连声音都被自己消掉了。）
	ELSEIF CFLAG:6:睡眠
		;睡眠时（未开眠奸口上则不会进来）——无台词
	ELSEIF CFLAG:6:318 == 1
		;@AT 测试通过 K6_300_318
		PRINTFORMW 「………」
	ELSE
		;=== 选定要演的台词编号 LOCAL:2（编号：11/12中立 13生疏 10思慕 20/21恋慕 30/31恋人 32地上月亮 40/41爱欲炮友 51-59时段 70-73约会中）===
		IF CFLAG:6:1098
			;--- AUTOTEST 强制指定台词：CFLAG:6:1098>0 时跳过所有随机、直接演该编号 ---
			;    SKILL 约定 CFLAG:{角色号}:1098=自动测试强制台词号；harness 逐条 set 它，实现对每条台词的确定性覆盖。
			LOCAL:2 = CFLAG:6:1098
		ELSEIF RAND:5 == 0
			;时段应景台词：任何关系都有 20% 概率触发（不固定加在别的话前面）→ 转成 5x 编号交由下方统一演出
			SELECTCASE TIME:2
				CASE 1
					LOCAL:2 = 51
				CASE 2
					LOCAL:2 = 52
				CASE 3, 4
					LOCAL:2 = 53
				CASE 5
					LOCAL:2 = 55
				CASEELSE
					LOCAL:2 = 59
			ENDSELECT
		ELSE
			;=== 向下兼容候选池：按当前关系把「合格」台词编号塞进 pool 再 RAND 抽一条 ===
			;越亲密可选越多（恋慕/恋人也会出思慕/中立，向下兼容）。门控：生疏台词仅真·不亲密时入池；
			;恋爱向台词(思慕/恋慕/恋人)在 爱欲/炮友(纯性关系)下不入池；爱欲/炮友有专属台词。
			LOCAL:1 = 0
			;--- 中立·随和（一直可出）---
			pool:(LOCAL:1) = 11
			LOCAL:1 += 1
			;--- 中立·傲娇自夸（12：「最强月之妖精别小看我」——不算冷淡，非恋爱/性关系基调时可出）---
			IF !TALENT:6:恋慕 && !TALENT:6:恋人 && !TALENT:6:愛欲 && !TALENT:6:炮友
				pool:(LOCAL:1) = 12
				LOCAL:1 += 1
			ENDIF
			;--- 中立·生疏（13：「人类找妖精搭话很少见」——真·陌生台词，仅 好感度<500 且未到思慕 时入池，
			;    免得已是好朋友/思慕的玩家还被当外人。好感度门控参考：250以下生疏/500以下点头之交）---
			IF !TALENT:6:思慕 && !TALENT:6:恋慕 && !TALENT:6:恋人 && !TALENT:6:愛欲 && !TALENT:6:炮友 && CFLAG:6:好感度 < 500
				pool:(LOCAL:1) = 13
				LOCAL:1 += 1
			ENDIF
			;--- 爱欲/炮友专属（性关系基调，独立于恋爱向）---
			IF TALENT:6:愛欲 || TALENT:6:炮友
				pool:(LOCAL:1) = 40
				LOCAL:1 += 1
				pool:(LOCAL:1) = 41
				LOCAL:1 += 1
			ENDIF
			;--- 恋爱向：思慕/恋慕/恋人（爱欲/炮友 下不入池）---
			IF (TALENT:6:思慕 || TALENT:6:恋慕 || TALENT:6:恋人) && !TALENT:6:愛欲 && !TALENT:6:炮友
				pool:(LOCAL:1) = 10
				LOCAL:1 += 1
			ENDIF
			IF (TALENT:6:恋慕 || TALENT:6:恋人) && !TALENT:6:愛欲 && !TALENT:6:炮友
				pool:(LOCAL:1) = 20
				LOCAL:1 += 1
				pool:(LOCAL:1) = 21
				LOCAL:1 += 1
			ENDIF
			IF TALENT:6:恋人 && !TALENT:6:愛欲 && !TALENT:6:炮友
				pool:(LOCAL:1) = 30
				LOCAL:1 += 1
				pool:(LOCAL:1) = 31
				LOCAL:1 += 1
				;「地上的月亮」只在她真·自室(33)入池
				IF CFLAG:MASTER:現在位置 == 33 && CFLAG:6:現在位置 == CFLAG:MASTER:現在位置
					pool:(LOCAL:1) = 32
					LOCAL:1 += 1
				ENDIF
			ENDIF
			;--- 约会中：约会专属台词【入池】而非排他覆盖 ---
			;    约会持续很久、会話次数多，若排他就整场只剩这一句；入池后平时台词照常出现，约会味道点到为止。
			;    只按当前关系追加一条（约会中的语气比平时更专注更黏）。约会中判定＝ pitfall #8 惯用式。
			IF CHK_DATENOW(CFLAG:MASTER:约会中) && FLAG:约会的对象 == TARGET
				IF TALENT:6:恋人
					pool:(LOCAL:1) = 70
				ELSEIF TALENT:6:恋慕
					pool:(LOCAL:1) = 71
				ELSEIF TALENT:6:思慕 || CFLAG:6:好感度 >= 1000
					pool:(LOCAL:1) = 72
				ELSE
					pool:(LOCAL:1) = 73
				ENDIF
				LOCAL:1 += 1
			ENDIF
			;从池里随机取一条
			LOCAL:2 = pool:(RAND:(LOCAL:1))
		ENDIF
		;=== 按编号演出对应台词（时段 5x 与候选池编号统一在此，harness 用 CFLAG:6:1098 逐条强制）===
		SELECTCASE LOCAL:2
			CASE 51
				;@AT 测试通过 K6_300_时段早朝
				PRINTFORMW 「唔……这么早……我两点才睡的，脑子还是糊的，别、别催啦。」
			CASE 52
				;@AT 测试通过 K6_300_时段上午
				PRINTFORMW 「上午了啊……太阳越爬越高，妖精都要被晒蔫了。」
			CASE 53
				;@AT 测试通过 K6_300_时段白天
				PRINTFORMW 「大白天的，又吵又亮……你也知道我白天不太行的，有话快说啦。」
			CASE 55
				;@AT 测试通过 K6_300_时段黄昏
				PRINTFORMW 「天总算暗下来了……嗯，我稍微、精神了那么一点点。」
			CASE 59
				;@AT 测试通过 K6_300_时段夜
				PRINTFORMW 「夜里好——现在，才是我月之妖精的主场哦。」
			CASE 11
				;@AT 测试通过 K6_300_中立a
				PRINTFORML 「你手里那杯，是咖啡吗？……没、没什么，我只是随口一问。」
				PRINTFORMW （露娜的视线，却怎么也离不开那杯咖啡。）
			CASE 12
				;@AT 测试通过 K6_300_中立b
				PRINTFORML 「我可是光之三妖精里，最强的月之妖精。」
				PRINTFORMW 「所以……别、别小看我啊。（她一边说，一边悄悄往后退了半步。）」
			CASE 13
				;@AT 测试通过 K6_300_生疏
				PRINTFORMW 「哼，人类找妖精搭话，可是很少见的。」
				PRINTFORMW 「有话快说……昨天没睡好，困着呢。」
			CASE 40
				;@AT 测试通过 K6_300_愛欲炮友a
				PRINTFORML 「光说话，多没意思呀。」
				PRINTFORMW （露娜把周围的声音一收，凑到耳边，用只有两人能听见的音量说道。）
			CASE 41
				;@AT 测试通过 K6_300_愛欲炮友b
				PRINTFORMW 「呐……趁现在没人，把声音都消掉，做点只有我们知道的事……也不是不行哦？」
			CASE 10
				;@AT 测试通过 K6_300_思慕
				PRINTFORMW %TEXTR("「无聊的话……要不要，听我说两句？」/「桑尼又搞砸了恶作剧，真是的。」/「大晴天，太吵、也太亮了。」")%
			CASE 20
				;@AT 测试通过 K6_300_恋慕a
				PRINTFORML 「那、那个——你不觉得我今天，有哪里不一样吗？」
				PRINTFORMW （%CALLNAME:MASTER%仔细一看，她帽子上系了一条崭新的黑丝带。被夸了一句，她整张脸都红透了。）
			CASE 21
				;@AT 测试通过 K6_300_恋慕b
				PRINTFORML 「我、我才不会因为%CALLNAME:MASTER%说两句话就高兴呢。」
				PRINTFORMW （话是这么说，露娜的嘴角却怎么也压不下去。）
			CASE 30
				;@AT 测试通过 K6_300_恋人a
				PRINTFORML 「呐、%CALLNAME:MASTER%……夜里睡不着的时候，可以来找我哦。」
				PRINTFORMW 「反正我本来就醒着嘛。……才、才不是特意等你呢。」
			CASE 31
				;@AT 测试通过 K6_300_恋人b
				PRINTFORML 「哈啊……和你在一起的时候，连抱怨都变少了。真奇怪。」
				PRINTFORMW （露娜靠了过来，把头轻轻搁在%CALLNAME:MASTER%肩上。）
			CASE 32
				;@AT 测试通过 K6_300_地上月亮
				PRINTFORML 「你看你看，我把这颗会反光的小石头，摆在了窗边。」
				PRINTFORMW 「等房间铺满这些，就是『地上的月亮』了。到时候……也分你一半好了。」
			CASE 70
				;@AT 待自动测试 K6_300_约会中恋人
				PRINTFORMW 「呐，趁现在……多陪我说会儿话嘛。和你一起的时候，连夜晚都变短了呢。」
			CASE 71
				;@AT 待自动测试 K6_300_约会中恋慕
				PRINTFORMW 「这、这算是……约会吧？我可是特意空出时间的哦，你、你要好好珍惜啊！」
			CASE 72
				;@AT 待自动测试 K6_300_约会中心动
				PRINTFORMW 「跟你一起出来逛……嗯，比想象中有意思。哼，别误会，只是今天心情好而已啦。」
			CASE 73
				;@AT 待自动测试 K6_300_约会中中立
				PRINTFORMW 「难得出来一趟……你可别光顾着自己走，把我这个夜之妖精晒晕了可不管哦。」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

