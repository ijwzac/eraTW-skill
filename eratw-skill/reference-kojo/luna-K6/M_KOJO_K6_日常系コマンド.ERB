		PRINTFORMW 「我、我把周围的杂音都消掉，你就……别紧张，好好弹给她们听吧。」
	ELSEIF (SHIRAHU(94) && CFLAG:94:現在位置 == CFLAG:MASTER:現在位置) || (SHIRAHU(95) && CFLAG:95:現在位置 == CFLAG:MASTER:現在位置) || (SHIRAHU(96) && CFLAG:96:現在位置 == CFLAG:MASTER:現在位置)
		;付丧神（乐器化身）同场
		;@AT 测试通过 K6_416_付丧神
		PRINTFORML 「那几位……是乐器变成的付丧神吧？连乐器本身都在听你弹……」
		PRINTFORMW 「唔，压力好大。要、要是弹得不好，它们会不会生气啊……我先帮你消个音壮胆。」
	ELSEIF SHIRAHU(124) && CFLAG:124:現在位置 == CFLAG:MASTER:現在位置
		;摩多罗隐岐奈同场
		;@AT 待手动测试 K6_416_隐岐奈
		SIF K6_MT_ON()
		PRINTL [[MT K6_416_隐岐奈]]
		PRINTFORML 「（压低声音）……那位是隐岐奈大人吧……后户之神……我、我腿都软了。」
		PRINTFORMW 「在这种大人物面前演奏……%CALLNAME:MASTER%你可别出错啊，我先躲你后面。」
	ELSE
		;--- 桑尼/斯塔在场时，33% 概率出三妖精应景变体 ---
		IF ((SHIRAHU(5) && CFLAG:5:現在位置 == CFLAG:MASTER:現在位置) || (SHIRAHU(7) && CFLAG:7:現在位置 == CFLAG:MASTER:現在位置)) && RAND:3 == 0
			;@AT 测试通过 K6_416_三妖精
			SELECTCASE TFLAG:193
				CASE 1
					PRINTFORML 「哇……桑尼、斯塔，你们听！人类居然弹得这么好！」
					PRINTFORMW （露娜一时忘了逞强，拉着姐妹一起听得入神。）
				CASEELSE
					PRINTFORMW 「喂喂，别在桑尼和斯塔面前露怯啊……不、不然我多没面子。」
			ENDSELECT
		ELSE
			;--- default：按当前乐器 ---
			SELECTCASE TFLAG:使用楽器
				CASE 1
					;电子琴/键盘
					;@AT 测试通过 K6_416_键盘
					PRINTFORMW 「电子琴啊……这音色亮得像月光洒下来，倒是……挺合我胃口的。」
				CASE 2
					;钢琴
					;@AT 待手动测试 K6_416_钢琴
					SIF K6_MT_ON()
					PRINTL [[MT K6_416_钢琴]]
					PRINTFORMW 「钢琴？这么大的家伙……声音沉得能压住夜里的安静，我、我喜欢。」
				CASE 3
					;吉他
					;@AT 待手动测试 K6_416_吉他
					SIF K6_MT_ON()
					PRINTL [[MT K6_416_吉他]]
					PRINTFORMW 「吉他呀，随手就能弹。哼，别以为这样就能收买我……多、多弹两首也行。」
				CASE 4
					;小号
					;@AT 待手动测试 K6_416_小号
					SIF K6_MT_ON()
					PRINTL [[MT K6_416_小号]]
					PRINTFORML 「哇——太、太吵了！小号在夜里吹，会把好不容易睡着的桑尼吵醒的啦！」
					PRINTFORMW （露娜手忙脚乱地想把声音消掉，却又舍不得完全消干净。）
				CASE 5
					;小提琴
					;@AT 测试通过 K6_416_小提琴
					PRINTFORMW 「小提琴……这声音，像月夜里的风。……再、再拉一会儿嘛，就一会儿。」
				CASEELSE
					;无当前乐器/未识别
					;@AT 待手动测试 K6_416_无乐器
					SIF K6_MT_ON()
					PRINTL [[MT K6_416_无乐器]]
					PRINTFORMW 「唔，演奏啊……我把周围的杂音都消掉了，你尽管弹，我听着呢。」
			ENDSELECT
		ENDIF
	ENDIF
ENDIF
RETURN 1

