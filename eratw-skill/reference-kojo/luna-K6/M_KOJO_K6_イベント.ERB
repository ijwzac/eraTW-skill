	SELECTCASE ARG
		CASE 0
			;告白内容（之后会弹出是否接受的选项）
			;@AT 待手动测试 K6_SPEVENT2_告白
			SIF K6_MT_ON()
			PRINTL [[MT K6_SPEVENT2_告白]]
			PRINTFORML 「我……我想了很久，也抱怨了很久。」
			PRINTFORML 「明明是妖精，明明只要恶作剧和睡觉就够了……可满脑子却都是%CALLNAME:MASTER%。」
			PRINTFORMW 「所以……那个。以后，能不能只对我一个人，特别一点？」
		CASE 1
			;告白成功
			PRINTFORML 「真、真的可以吗！？」
			PRINTFORMW （露娜高兴得跳起来，又一下没踩稳，扑进了%CALLNAME:MASTER%怀里——这次她没有再逞强推开。）
		CASE 2
			;告白失败
