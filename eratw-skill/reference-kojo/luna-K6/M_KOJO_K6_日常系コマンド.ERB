@M_KOJO_MESSAGE_COM_K6_416_1
LOCAL = 1
IF LOCAL
	IF FLAG:時間停止
	;--- 乐手三组同场（以 or 连接，各一种台词）---
	ELSEIF (SHIRAHU(20) && CFLAG:20:現在位置 == CFLAG:MASTER:現在位置) || (SHIRAHU(21) && CFLAG:21:現在位置 == CFLAG:MASTER:現在位置) || (SHIRAHU(22) && CFLAG:22:現在位置 == CFLAG:MASTER:現在位置)
		;骚灵三姐妹（普利兹姆利巴）同场
