;==================================================
;GIFT —— 收到礼物
;「自定义参数，需 #DIM/#DIMS」：引擎按【位置】传来 5 个实参，但 Emuera 只自动认 ARG/ARG:N/ARGS；
;  下面这些是作者自取的参数名，必须 #DIM(数值)/#DIMS(字符串) 声明，否则读出来恒为 0/空（pitfall #1）。
;ARG 分档（引擎 ERB\イベント関連\贈り物関連\贈り物.ERB:310-346；評価点范围 0-999）：
;  1=角色主动回赠 / 2=珍藏(評価点≥700，每次都发) / 3=刷新「最爱」纪录(≥700 且 ≥历史最高)
;  4=普通收下(400-699，最常见的一档) / 5=偷偷变卖(<400)
;⚠ARG2 与 ARG3 会【连发】(贈り物.ERB:320 发完 2、327 判定破纪录再发 3)：
;  故 ARG2 写完整反应、ARG3 只补一句「刷新纪录」的短话，避免同一次送礼里重复长篇。
;参考：中性礼物≈500(落 ARG4)，命中一条喜好≈666，≥700 要命中 4 条以上喜好 tag，≥800 极罕见。
;==================================================
@M_KOJO_EVENT_K6_GIFT(ARG, GIFT_ID, 評価点, GIFT_NAME, SENSE)
#DIM GIFT_ID
#DIM 評価点
#DIMS GIFT_NAME
#DIMS SENSE
SELECTCASE ARG
	CASE 2
		;珍藏（≥700）——咖啡豆/月亮相关的东西她最喜欢。这是「她真的很喜欢」的主反应。
		;顺带解锁日记「藏在枕头下的宝物」页(page5)、记住礼物名与累计件数（见 M_KOJO_K6_日記.ERB）。
		;置 1081 是幂等的；礼物名/件数每收到一件珍藏级礼物就刷新一次。
		CFLAG:6:1081 = 1
		CSTR:6:81 = %GIFT_NAME%
		CFLAG:6:1082 += 1
		IF STRCOUNT(SENSE, "飲料/") || STRCOUNT(GIFT_NAME, "咖啡")
			;@AT 待自动测试 K6_GIFT_珍藏咖啡
			PRINTFORML 「咖、咖啡豆！你怎么知道……！这可比从茶店偷来的香多了！」
			PRINTFORMW 「哼，算你有心。……谢、谢谢啦。」
		ELSE
			;@AT 待自动测试 K6_GIFT_珍藏其它
			PRINTFORML 「哇——这个『%GIFT_NAME%』，会不会反光？摆在房间里，像不像掉下来的月亮？」
			PRINTFORMW 「嘿嘿……我要把房间，变成地上的月亮呢。」
		ENDIF
	CASE 3
		;刷新「最爱」纪录——紧接在 ARG2 的反应之后发，故这里只补一句短的。
		;@AT 待自动测试 K6_GIFT_最爱
		PRINTFORMW 「……这个啊，是我收到过的里面，最喜欢的了。才、才不是因为是你送的哦！」
	CASE 4
		;普通收下（400-699）——最常见的一档：不讨厌，但也没到珍藏的程度。
		IF CFLAG:6:好感度 >= 1000
			;@AT 待自动测试 K6_GIFT_普通心动
			PRINTFORML 「『%GIFT_NAME%』……嗯，收下了。」
			PRINTFORMW （露娜嘴上淡淡的，转身却把它仔细揣进了怀里。）
		ELSE
			;@AT 待自动测试 K6_GIFT_普通中立
			PRINTFORML 「唔……『%GIFT_NAME%』啊。谢、谢谢……大概？」
			PRINTFORMW （她翻来覆去看了半天，好像在认真研究这东西到底能拿来干嘛。）
		ENDIF
	CASE 1
		;@AT 待自动测试 K6_GIFT_回礼
		PRINTFORMW 「那个…我上次满月捡到了这个『%GIFT_NAME%』，你如果…如果…总之你就收下嘛。」
	CASE 5
		;@AT 待自动测试 K6_GIFT_变卖
		PRINTFORMW （露娜把『%GIFT_NAME%』掂了掂，趁你没注意，无声无息地塞进了怀里……）
ENDSELECT
RETURN 1

;==================================================
;RUN_INTO —— 地图上偶遇
;==================================================
@RUN_INTO_K6(MAP_ID)
#DIM MAP_ID
;TIME:2 时段桶：1~4=白天、5(夕)~7(深夜)=夜；夜之妖精夜里才是主场，故 >=5 判夜。
IF TIME:2 >= 5
	;夜晚——她的主场
	;@AT 待手动测试 K6_RUNINTO_夜
	SIF K6_MT_ON()
	PRINTL [[MT K6_RUNINTO_夜]]
	PRINTFORMW 「哟，是%CALLNAME:MASTER%。夜里出来……难得跟我一样呢。要不要，陪我找找掉下来的月光？」
ELSE
	;@AT 待手动测试 K6_RUNINTO_昼
	SIF K6_MT_ON()
	PRINTL [[MT K6_RUNINTO_昼]]
	PRINTFORMW 「唔……大白天的居然撞见你。眼睛好刺……我先躲一躲。」
ENDIF
RETURN 1

