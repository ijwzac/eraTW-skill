;※※※※※※※※※※※※※※※※※※※※※※※※※
;日常系指令
;露娜：迟钝、爱讲理、头号胆小鬼；夜之妖精；消音能力；偷咖啡；爱摔跤。
;
;测试状态标记约定：每个会出声的分支上方一行  ;@AT <状态> <TID>
;  状态 ∈ 待自动测试 / 待手动测试 / 测试通过 / 测试失败
;  TID   稳定唯一，形如 K6_<指令>_<分支>；自动测试与集成测试脚本据此回写状态
;※※※※※※※※※※※※※※※※※※※※※※※※※

;==================================================
;300,会話
;TFLAG:193(1=大成功 0=成功 -1=失敗 -2=大失敗)
;==================================================
@M_KOJO_SUCCESS_COM_K6_300
;成否判定 TFLAG:192(-2=终了 -1=强制失败 0=依指令 1=强制成功/大成功)
TFLAG:192 = 0

@M_KOJO_MESSAGE_MESSAGECHECK_COM_K6_300
RETURN 0

@M_KOJO_MESSAGE_COM_K6_300
;=== AUTOTEST 钩子（临时，交付前必须删除；见 M_KOJO_K6_AUTOTEST.ERB）===
IF !TCVAR:6:399
	CALL M_KOJO_K6_AUTOTEST
	RETURN 1
ENDIF
;=== end AUTOTEST 钩子 ===
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K6_300_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_300_1
;-------------------------------------------------
;记入检查（=0 不显示，1 显示）
LOCAL = 1
;-------------------------------------------------
IF LOCAL
	IF FLAG:時間停止
		;@AT 待自动测试 K6_300_時停
		;时停时（已开启 時間停止口上有）无意识地嘟囔
		PRINTFORMW （静止的时间里，露娜维持着抱怨到一半的表情，连声音都被自己消掉了。）
	ELSEIF CFLAG:6:睡眠
		;睡眠时（未开眠奸口上则不会进来）——无台词
	ELSEIF CFLAG:6:318 == 1
		;@AT 待自动测试 K6_300_318
		;极度闹别扭/无视
		PRINTFORMW 「………」
	ELSEIF TALENT:6:恋人
		;@AT 待自动测试 K6_300_恋人
		SELECTCASE RAND:4
			CASE 0
				PRINTFORML 「稍微，等一下。」
				PRINTFORML （露娜啪地打了个响指，四周的声音一下子全没了。）
				PRINTFORMW 「这样……就只有我们两个人了。想说什么，都可以哦？」
			CASE 1
				PRINTFORML 「呐、%CALLNAME:MASTER%……夜里睡不着的时候，可以来找我哦。」
				PRINTFORMW 「反正我本来就醒着嘛。……才、才不是特意等你呢。」
			CASE 2
				;「地上的月亮」应仅在【露娜自室内】触发才合情景。
				;TODO(位置判定)：AI 暂不知道露娜房间的位置码。请在游戏内让主角进入露娜房间，
				;  用调试控制台执行  PRINTFORML {CFLAG:MASTER:現在位置}  把房间号告诉我，再来改这里。
				;  注意：主角若不住在露娜所在大地图，露娜房间可能被并入「三妖精大树」整体房间，
				;  故最终或需两码 or 判定：(CFLAG:MASTER:現在位置 == <露娜自室码> || == <三妖精大树码>)
				;  在拿到房间码前，暂用「同格＋50%」占位：
				IF CFLAG:6:現在位置 == CFLAG:MASTER:現在位置 && RAND:2 == 0
					PRINTFORML 「你看你看，我把这颗会反光的小石头，摆在了窗边。」
					PRINTFORMW 「等房间铺满这些，就是『地上的月亮』了。到时候……也分你一半好了。」
				ELSE
					PRINTFORML 「今天也……难得没被桑尼拉去搞恶作剧呢。」
					PRINTFORMW 「所以、那个……多陪我待一会儿，也不是不行啦。」
				ENDIF
			CASEELSE
				PRINTFORML 「哈啊……和你在一起的时候，连抱怨都变少了。真奇怪。」
				PRINTFORMW （露娜靠了过来，把头轻轻搁在%CALLNAME:MASTER%肩上。）
		ENDSELECT
	ELSEIF TALENT:6:愛欲 || TALENT:6:炮友
		;@AT 待自动测试 K6_300_愛欲炮友
		PRINTFORML 「光说话，多没意思呀。」
		PRINTFORMW （露娜把周围的声音一收，凑到耳边，用只有两人能听见的音量说道。）
	ELSEIF TALENT:6:恋慕
		;@AT 待自动测试 K6_300_恋慕
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「那、那个——你不觉得我今天，有哪里不一样吗？」
				PRINTFORMW （%CALLNAME:MASTER%仔细一看，她帽子上系了一条崭新的黑丝带。被夸了一句，她整张脸都红透了。）
			CASE 1
				PRINTFORML 「斯塔给了我一朵没有刺的蔷薇，还说什么『露娜看不出这蔷薇没刺吗』……」
				PRINTFORMW 「哈啊，那家伙到底在想什么，我完全搞不懂啦。」
			CASEELSE
				PRINTFORML 「我、我才不会因为%CALLNAME:MASTER%说两句话就高兴呢。」
				PRINTFORMW （话是这么说，露娜的嘴角却怎么也压不下去。）
		ENDSELECT
	ELSEIF TALENT:6:思慕
		;@AT 待自动测试 K6_300_思慕
		;单行随机（TEXTR 内容为动态，签名交给集成测试用整句）
		PRINTFORMW %TEXTR("「无聊的话……要不要，听我说两句？」/「桑尼又搞砸了恶作剧，真是的。」/「大晴天，太吵、也太亮了。」")%
	ELSE
		;@AT 待自动测试 K6_300_中立
		SELECTCASE RAND:3
			CASE 0
				PRINTFORML 「哼，人类找妖精搭话，可是很少见的。」
				PRINTFORMW 「有话快说……我夜里才有精神，白天犯困着呢。」
			CASE 1
				PRINTFORML 「我可是光之三妖精里，最强的月之妖精。」
				PRINTFORMW 「所以……别、别小看我啊。（她一边说，一边悄悄往后退了半步。）」
			CASEELSE
				PRINTFORML 「你手里那杯，是咖啡吗？……没、没什么，我只是随口一问。」
				PRINTFORMW （露娜的视线，却怎么也离不开那杯咖啡。）
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

;==================================================
;301,泡茶（露娜其实更想要咖啡）
;==================================================
@M_KOJO_SUCCESS_COM_K6_301
TFLAG:192 = 0

@M_KOJO_MESSAGE_COM_K6_301
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K6_301_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_301_1
LOCAL = 1
IF LOCAL
	IF FLAG:時間停止
	ELSEIF TALENT:6:恋慕
		;@AT 待自动测试 K6_301_恋慕
		PRINTFORMW 「谢谢——不过下次，能换成咖啡吗？煮咖啡我和斯塔都会啦，可我想喝你泡的。」
	ELSEIF MARK:6:不埒刻印 == 3
		;@AT 待自动测试 K6_301_不埒3
		PRINTFORMW 「……（露娜乖乖捧着茶杯，不敢像平时那样挑三拣四。）」
	ELSE
		;@AT 待自动测试 K6_301_中立
		PRINTFORMW 
		SELECTCASE RAND:3
			CASE 0
				PRINTFORMW 「茶啊……要是有别的饮品，我可是会更高兴的哦？」
			CASE 1
				PRINTFORMW 「呼呼，你还是挺机灵的嘛。」
			CASEELSE
				PRINTFORMW 「哼，只像有我这样强大的妖精，才懂得欣赏茶和咖啡呢。」
		ENDSELECT
	ENDIF
ENDIF
RETURN 1

