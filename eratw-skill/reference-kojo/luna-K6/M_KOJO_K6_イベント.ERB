@M_KOJO_K6(ARG)
;存在判定，绝对不要注释掉，也不要在这里做别的处理
RETURN 1

;### 口上基本旗标设定 ###############################
@M_KOJO_FLAGSETTING_K6
;时停/眠奸/扮演时是否照常念口上（1=念）
CFLAG:6:時間停止口上有 = 1
CFLAG:6:眠姦口上有 = 0
CFLAG:6:扮演口上有 = 1
;口上内抱き寄せ（推倒）判定交由 PERMISSION 处理
CFLAG:6:口上内抱き寄せ判定_初回 = 1
CFLAG:6:口上内抱き寄せ判定_通常 = 1
;破瓜取消口上交由 LOST_VIRGIN_STOP 处理
CFLAG:6:破瓜中止口上有 = 1
;还没面识时不主动来访（胆小、怕生）
IF !CFLAG:6:面識
	CFLAG:6:来訪不能 = 1
ELSE
	CFLAG:6:来訪不能 = 0
ENDIF
;没到恋慕之前不会自己扑上来（她可是头号胆小鬼）
IF !TALENT:6:恋慕 && !TALENT:6:炮友
	CFLAG:6:推倒禁止 = 1
ELSE
	CFLAG:6:推倒禁止 = 0
ENDIF
;=== AUTOTEST 外部 arm 哨兵（本 skill 口上的标记 + 开关；面向玩家交付前删除本段与哨兵文件）===
;  本口上目录里放一个哨兵文件：autotest.on=启用 / autotest.off=禁用（用文件名编码状态，因 EXISTFILE 只判存在）。
;  启动器扫 個人口上/**/autotest.o* 即可发现所有 skill 口上并读出状态，并按玩家选择在 .on/.off 间改名切换。
;  读档时本函数必被调用：若哨兵为 autotest.on 就把待命位置 1。!=2 保持三态语义(本存档跑过一次不再重 arm)。
IF CFLAG:6:1099 != 2 && EXISTFILE("ERB/口上・メッセージ関連/個人口上/006 Luna [ルナ]/露娜切露德_重制/autotest.on")
	CFLAG:6:1099 = 1
ENDIF
RETURN 1

