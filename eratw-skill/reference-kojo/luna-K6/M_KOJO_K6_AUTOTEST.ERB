;============================================================
;AUTOTEST harness for K6 (露娜切露德) — 临时文件，交付前必须删除！
;
;触发：会話(300) 处理体顶部一个 3 行守卫钩子调用本电池：
;   @M_KOJO_MESSAGE_COM_K6_300  顶部：
;     IF !TCVAR:6:399
;         CALL M_KOJO_K6_AUTOTEST
;         RETURN 1
;     ENDIF
;
;守卫标记：TCVAR:6:399 = 口上自动测试开关（非存档、按角色、作者私有 350-399）。
;  当 TCVAR:6:399==0（默认）时触发；电池结尾把它置 1（本次会话只跑一次）。
;  想再跑一次：在调试控制台执行  TCVAR:6:399 = 0
;
;⚠ 因为默认值 0 = 已武装（玩家也是 0），若钩子被误交付，玩家第一次「会話」
;  就会触发本测试。故【交付前必须】注释掉钩子并删除本文件。
;
;本电池内部注入状态（无需在控制台打字），逐层 CALL 各 _1 台词体，
;用 [[TID <id> BEGIN]] / [[TID <id> OK]] 包裹每个分支，脚本据此回写 ;@AT 状态：
;  BEGIN 有、OK 有 → 测试通过；BEGIN 有、OK 无（引擎中途 halt）→ 测试失败。
;每个台词分支自带 PRINTFORMW，屏幕会停住，clip_tap 逐块抓取。
;============================================================
@M_KOJO_K6_AUTOTEST
#DIM sav, 24
;--- 保存将被改写的槽位 ---
sav:0 = TALENT:6:恋人
sav:1 = TALENT:6:愛欲
sav:2 = TALENT:6:炮友
sav:3 = TALENT:6:恋慕
sav:4 = TALENT:6:思慕
sav:5 = CFLAG:6:面識
sav:6 = FLAG:時間停止
sav:7 = CFLAG:6:318
sav:8 = MARK:6:不埒刻印
sav:9 = BASE:6:酒気

TARGET = 6
CFLAG:6:面識 = 1
FLAG:時間停止 = 0
CFLAG:6:318 = 0
MARK:6:不埒刻印 = 0
BASE:6:酒気 = 0

PRINTL =====AUTOTEST_K6_BEGIN=====
PRINTFORML [INFO] K6=%CALLNAME:6% MASTER=%CALLNAME:MASTER% 面識={CFLAG:6:面識}

;--- COLOR（无台词，仅应用颜色）---
PRINTL [[TID K6_COLOR BEGIN]]
CALL M_KOJO_COLOR_K6
RESETCOLOR
PRINTL [[TID K6_COLOR OK]]

;--- ENCOUNTER（初遇）---
PRINTL [[TID K6_ENCOUNTER BEGIN]]
CALL M_KOJO_ENCOUNTER_K6
PRINTL [[TID K6_ENCOUNTER OK]]

;=== 300 会話 分层扫描 ===
PRINTL [[TID K6_300_中立 BEGIN]]
CALL AT_CLEAR_K6
CALL M_KOJO_MESSAGE_COM_K6_300_1
PRINTL [[TID K6_300_中立 OK]]

PRINTL [[TID K6_300_思慕 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:思慕 = 1
CALL M_KOJO_MESSAGE_COM_K6_300_1
PRINTL [[TID K6_300_思慕 OK]]

PRINTL [[TID K6_300_恋慕 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋慕 = 1
CALL M_KOJO_MESSAGE_COM_K6_300_1
PRINTL [[TID K6_300_恋慕 OK]]

PRINTL [[TID K6_300_愛欲炮友 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:愛欲 = 1
CALL M_KOJO_MESSAGE_COM_K6_300_1
PRINTL [[TID K6_300_愛欲炮友 OK]]

PRINTL [[TID K6_300_恋人 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋人 = 1
CALL M_KOJO_MESSAGE_COM_K6_300_1
PRINTL [[TID K6_300_恋人 OK]]

PRINTL [[TID K6_300_318 BEGIN]]
CALL AT_CLEAR_K6
CFLAG:6:318 = 1
CALL M_KOJO_MESSAGE_COM_K6_300_1
CFLAG:6:318 = 0
PRINTL [[TID K6_300_318 OK]]

PRINTL [[TID K6_300_時停 BEGIN]]
CALL AT_CLEAR_K6
FLAG:時間停止 = 1
CALL M_KOJO_MESSAGE_COM_K6_300_1
FLAG:時間停止 = 0
PRINTL [[TID K6_300_時停 OK]]

;=== 301 泡茶 ===
PRINTL [[TID K6_301_中立 BEGIN]]
CALL AT_CLEAR_K6
CALL M_KOJO_MESSAGE_COM_K6_301_1
PRINTL [[TID K6_301_中立 OK]]

PRINTL [[TID K6_301_恋慕 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋慕 = 1
CALL M_KOJO_MESSAGE_COM_K6_301_1
PRINTL [[TID K6_301_恋慕 OK]]

PRINTL [[TID K6_301_不埒3 BEGIN]]
CALL AT_CLEAR_K6
MARK:6:不埒刻印 = 3
CALL M_KOJO_MESSAGE_COM_K6_301_1
MARK:6:不埒刻印 = 0
PRINTL [[TID K6_301_不埒3 OK]]

;=== 302 身体接触 ===
PRINTL [[TID K6_302_中立 BEGIN]]
CALL AT_CLEAR_K6
CALL M_KOJO_MESSAGE_COM_K6_302_1
PRINTL [[TID K6_302_中立 OK]]

PRINTL [[TID K6_302_恋人 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋人 = 1
CALL M_KOJO_MESSAGE_COM_K6_302_1
PRINTL [[TID K6_302_恋人 OK]]

;=== 309 摸头 ===
PRINTL [[TID K6_309_中立 BEGIN]]
CALL AT_CLEAR_K6
CALL M_KOJO_MESSAGE_COM_K6_309_1
PRINTL [[TID K6_309_中立 OK]]

PRINTL [[TID K6_309_恋人 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋人 = 1
CALL M_KOJO_MESSAGE_COM_K6_309_1
PRINTL [[TID K6_309_恋人 OK]]

;=== 311 拥抱（初回=待手动，本电池跳过；只扫常规分支）===
PRINTL [[TID K6_311_中立 BEGIN]]
CALL AT_CLEAR_K6
CALL M_KOJO_MESSAGE_COM_K6_311_1
PRINTL [[TID K6_311_中立 OK]]

PRINTL [[TID K6_311_恋慕 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋慕 = 1
CALL M_KOJO_MESSAGE_COM_K6_311_1
PRINTL [[TID K6_311_恋慕 OK]]

PRINTL [[TID K6_311_恋人 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋人 = 1
CALL M_KOJO_MESSAGE_COM_K6_311_1
PRINTL [[TID K6_311_恋人 OK]]

;=== 312 接吻 ===
PRINTL [[TID K6_312_中立 BEGIN]]
CALL AT_CLEAR_K6
CALL M_KOJO_MESSAGE_COM_K6_312_1
PRINTL [[TID K6_312_中立 OK]]

PRINTL [[TID K6_312_恋慕 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋慕 = 1
CALL M_KOJO_MESSAGE_COM_K6_312_1
PRINTL [[TID K6_312_恋慕 OK]]

PRINTL [[TID K6_312_恋人 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋人 = 1
CALL M_KOJO_MESSAGE_COM_K6_312_1
PRINTL [[TID K6_312_恋人 OK]]

;=== 332 劝酒 ===
PRINTL [[TID K6_332_清醒 BEGIN]]
CALL AT_CLEAR_K6
BASE:6:酒気 = 0
CALL M_KOJO_MESSAGE_COM_K6_332_1
PRINTL [[TID K6_332_清醒 OK]]

PRINTL [[TID K6_332_醉 BEGIN]]
CALL AT_CLEAR_K6
BASE:6:酒気 = MAXBASE:6:酒気
CALL M_KOJO_MESSAGE_COM_K6_332_1
PRINTL [[TID K6_332_醉 OK]]

;=== 派生 306/307 ===
PRINTL [[TID K6_306_中立 BEGIN]]
CALL AT_CLEAR_K6
CALL M_KOJO_MESSAGE_COM_K6_306_1
PRINTL [[TID K6_306_中立 OK]]

PRINTL [[TID K6_306_恋人 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋人 = 1
CALL M_KOJO_MESSAGE_COM_K6_306_1
PRINTL [[TID K6_306_恋人 OK]]

PRINTL [[TID K6_307_中立 BEGIN]]
CALL AT_CLEAR_K6
CALL M_KOJO_MESSAGE_COM_K6_307_1
PRINTL [[TID K6_307_中立 OK]]

PRINTL [[TID K6_307_恋慕恋人 BEGIN]]
CALL AT_CLEAR_K6
TALENT:6:恋慕 = 1
CALL M_KOJO_MESSAGE_COM_K6_307_1
PRINTL [[TID K6_307_恋慕恋人 OK]]

;--- 复原全部改写的槽位 ---
TALENT:6:恋人 = sav:0
TALENT:6:愛欲 = sav:1
TALENT:6:炮友 = sav:2
TALENT:6:恋慕 = sav:3
TALENT:6:思慕 = sav:4
CFLAG:6:面識 = sav:5
FLAG:時間停止 = sav:6
CFLAG:6:318 = sav:7
MARK:6:不埒刻印 = sav:8
BASE:6:酒気 = sav:9

;--- 自动解除武装（本次会话只跑一次；再跑请在控制台 TCVAR:6:399 = 0）---
TCVAR:6:399 = 1

PRINTL =====AUTOTEST_K6_END=====
PRINTW [AUTOTEST] 完成 —— 状态已复原 —— TCVAR:6:399 置 1 —— 点击返回
RETURN 1

;--- 辅助：清零全部关系层 ---
@AT_CLEAR_K6
TALENT:6:恋人 = 0
TALENT:6:愛欲 = 0
TALENT:6:炮友 = 0
TALENT:6:恋慕 = 0
TALENT:6:思慕 = 0
RETURN 1
