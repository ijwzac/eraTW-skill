;==================================================
;约会归途（其它）
;==================================================
@M_KOJO_SPEVENT_MESSAGECHECK_K6_3
RETURN 0

@M_KOJO_SPEVENT_K6_3(ARG, ARG:1)
;约会归途·兜底口上。引擎有两条约会结束路径（已查证）：
;  ①玩家用「从外面回家」命令手动结束 → @DATE_EVENT：未被吻过发 SP_EVENT1(初吻)、达阈值发 SP_EVENT2(告白)、其余落【本槽 SP_EVENT3】。出处 DATE_CMN.ERB @DATE_EVENT:285/293。
;  ②角色自己到点回家(!VISIT) → @KITAKU → EVENT_20 ARG2(约会中帰宅)。出处 MOVEMENT2.ERB:254。
;  故「玩家手动结束约会时的归来对话」正是本槽位（初吻发生后每次手动回家都走这里）；EVENT_20 那套要角色自然到点才走。两条都要有内容。
LOCAL = 1
IF LOCAL
	IF TALENT:6:恋人
		;@AT 待手动测试 K6_SPEVENT3_恋人
		SIF K6_MT_ON()
		PRINTL [[MT K6_SPEVENT3_恋人]]
		PRINTFORML 「今天……玩得很开心。和你在一起，连白天都没那么难熬了。」
		PRINTFORMW （露娜把周围的声音一收，凑过来飞快地补了一句：「……下次，还要一起出去哦。」）
	ELSEIF TALENT:6:恋慕
		;@AT 待手动测试 K6_SPEVENT3_恋慕
		SIF K6_MT_ON()
		PRINTL [[MT K6_SPEVENT3_恋慕]]
		PRINTFORML （露娜揪着裙子，犹豫了半天）
		PRINTFORMW 「今天……还，还算有意思啦。明天你一定要人陪的话我也……不过我还得跟斯塔她们……」
	ELSE
		;思慕/中立
		;@AT 测试通过 K6_SPEVENT3_思慕
		PRINTFORMW 「回来啦……嗯，今天没摔跤，也没被桑尼笑话，算是不错的一天了。」
	ENDIF
ENDIF
RETURN 1

;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT" 系事件
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;1,房间/同格遭遇
;必须先做同格守卫：她不在你格子里就返回，否则每次她换格都会念
;ARG 1=你进来 2=她进来 3-5=浴室 6=外出遭遇 7=约会中被撞见 8=当日第一次问候 9=外出当日第一次问候(ARG:1=约会对象)
;==================================================
@M_KOJO_EVENT_K6_1(ARG, ARG:1)
;★同格守卫（SKILL pitfall #4）
SIF CFLAG:6:現在位置 != CFLAG:MASTER:現在位置
	RETURN 0
;★引擎分发设计（据典 K139 官方注释）：一次遭遇会依次触发多个 ARG 子相位——
;  当天首次见面时，引擎【先】发 ARG 8(室内首次问候)/9(外出首次问候)，【再】接常规遭遇 ARG 1/2(室内)/6/7(外出)。
;  故「每日首次＝额外问候＋常规遭遇」本就是原生设计：让 8/9 只放简短「今日首次」问候、1/2/6/7 放常规内容，
;  就会自然叠成「问候句＋日常句」两句，正是想要的效果。
;  8 与 9 之间用当日标记 TCVAR:6:350 去重（室内级与外出级问候同日只出一次）；常规遭遇(1/2/6/7)不加闸，
;  故同日再次遇见仍正常出声，只是不再重复「今日首次」问候。TCVAR:6:350 由 BEFORETRAIN 每日清零。
SELECTCASE ARG
	CASE 8
		;当天第一次见面·室内首次问候（之后引擎会接 ARG 1/2）
		SIF TCVAR:6:350
			RETURN 1
		TCVAR:6:350 = 1
		;★十六夜之夜特殊事件：@SPECIALDAY_EVENT_K6 不是引擎自动派发的标签，必须由口上自己从被引擎调用的事件里手动 CALL
		;  （参照こいし K38：在 EVENT_1 里日期判断后 CALL SPECIALDAY_EVENT_K38）。这里在「当日首次室内问候」时机触发，
		;  16 号入夜(TIME:2>=5)则用月见事件替代首问候；SPECIALDAY 内部还会再校验日期/面識/同处，返回 1 表示已触发。
		IF DAY:3 == 16 && TIME:2 >= 5
			CALL SPECIALDAY_EVENT_K6
			SIF RESULT == 1
				RETURN 1
		ENDIF
		;@AT 测试通过 K6_EV1_今日首问候
		IF TALENT:6:恋人
			PRINTFORMW 「啊，%CALLNAME:MASTER%……今天，还是第一次见你呢。哼，我、我才没有在数。」
		ELSE
			PRINTFORMW 「唔……又是你。今天头一回照面……哼，我可没有在等你哦。」
		ENDIF
		RETURN 1
	CASE 1
		;★闯入特殊房间（引擎通用房间类型判定，不硬编码房号）：厕所/浴室走二选一交互，厨房只馋一句
		IF IN_TOILET(CFLAG:MASTER:現在位置)
			CALL K6_INTRUDE_PRIVATE("厕所")
			RETURN 1
		ELSEIF BATHROOM()
			CALL K6_INTRUDE_PRIVATE("浴室")
			RETURN 1
		ELSEIF KITCHEN() && !(CFLAG:MASTER:現在位置 >= 26 && CFLAG:MASTER:現在位置 <= 35)
			;厨房馋相（仅非三妖精之家的厨房：26-35 是三妖精之家房号范围、含厨房29）
			;@AT 待手动测试 K6_EV1_厨房馋
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV1_厨房馋]]
			PRINTFORML （露娜正踮着脚，眼睛直勾勾盯着橱柜，手伸到一半又猛地缩了回来。）
			PRINTFORMW 「唔……我、我才不是要偷吃！只是在帮忙检查有没有坏掉的东西啦！对，就是这样！」
			RETURN 1
		ENDIF
		;主角走到了露娜所在的格子（地点不定：她的房间、屋外、别处都可能，故措辞须地点无关）
		;@AT 测试通过 K6_EV1_你走近
		IF TALENT:6:恋人
			PRINTFORML 「呀，%CALLNAME:MASTER%！」
			PRINTFORMW （露娜把周围的声音一收，凑过来小声说：「这样别人就听不到我们说话了……嘿嘿。」）
		ELSEIF TALENT:6:恋慕
			PRINTFORML 「唔哇！你、你别悄没声地凑过来啊，吓我一跳……！」
			PRINTFORMW （她慌慌张张把手里的东西往身后藏，像是刚才在偷偷摆弄什么。）
		ELSE
			PRINTFORMW 「唔……是你啊。哼，别自作多情，我可没在等你——只是刚好在这儿罢了。」
		ENDIF
		RETURN 1
	CASE 2
		;她进来了
		;@AT 测试通过 K6_EV1_她进来
		IF TALENT:6:恋人
			PRINTFORMW 「打扰啦——诶嘿，其实是想你了才来的。这种话，只有把声音消掉才敢说呢。」
		ELSE
			PRINTFORMW （露娜蹑手蹑脚地溜了进来，脚步没有一点声音，却在门槛上绊了个趔趄。）
		ENDIF
		RETURN 1
	CASE 6
		;外出遭遇
		;@AT 待手动测试 K6_EV1_外出遭遇
		SIF K6_MT_ON()
		PRINTL [[MT K6_EV1_外出遭遇]]
		PRINTFORML 「唔哇，是%CALLNAME:MASTER%……大白天的，晃得我眼睛疼。」
		PRINTFORMW 「我可是夜里才有精神的。白天遇到，就当没看见吧，互相的。」
		RETURN 1
	CASE 7
		;约会中被撞见（ARG:1=约会对象的角色号）
		;★特例：玩家正和桑尼(5)/斯塔(7)约会时撞见露娜——按露娜对玩家的关系分层（三妖精间的复杂心情）
		IF ARG:1 == 5 || ARG:1 == 7
			;@AT 待手动测试 K6_EV1_约会撞见姐妹
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV1_约会撞见姐妹]]
			IF TALENT:6:恋人
				PRINTFORML 「哦——是%CALLNAME:MASTER%和%CALLNAME:(ARG:1)%呀。」
				PRINTFORMW （露娜怔了怔，忽然释然地笑了。「……其实这样也挺好。三个人再加上你，大家一直一起玩下去——那才是最棒的嘛。」）
			ELSEIF TALENT:6:恋慕
				PRINTFORML 「……跟%CALLNAME:(ARG:1)%？为、为什么……偏偏不是我啊。」
				PRINTFORMW （露娜咬着下唇别过脸，那点藏不住的不甘心，比平时任何一次逞强都明显。）
			ELSEIF TALENT:6:思慕
				PRINTFORML 「诶、诶——！？你、你们两个……在、在约会！？」
				PRINTFORMW （露娜慌得话都说不利索，脸一路红到耳根，踉跄着后退了好几步。）
			ELSE
				PRINTFORML 「哦，和%CALLNAME:(ARG:1)%约会啊。」
				PRINTFORMW 「那家伙笨手笨脚的，你可得看好她——别让她给你惹太多麻烦哦。」
			ENDIF
			RETURN 1
		ENDIF
		;一般情形：和其他人约会时撞见
		;@AT 待手动测试 K6_EV1_约会撞见
		SIF K6_MT_ON()
		PRINTL [[MT K6_EV1_约会撞见]]
		PRINTFORML 「诶……%CALLNAME:MASTER%在跟别人约会？」
		PRINTFORMW （露娜张了张嘴想抱怨点什么，最后只是把周围的声音消掉，扭头飞走了。）
		RETURN 1
	CASE 9
		;当天第一次见面·外出首次问候（ARG:1=约会对象；之后引擎会接 ARG 6/7）
		SIF TCVAR:6:350
			RETURN 1
		TCVAR:6:350 = 1
		;@AT 待手动测试 K6_EV1_今日首问候外出
		SIF K6_MT_ON()
		PRINTL [[MT K6_EV1_今日首问候外出]]
		IF ARG:1
			PRINTFORMW 「哟，今天头一回碰到你……居然是在跟别人约会。哼，随便你啦。」
		ELSE
			PRINTFORMW 「哟，今天头一回碰到你呢。……才、才不是特意在找你，只是刚好路过啦。」
		ENDIF
		RETURN 1
ENDSELECT
RETURN 1

;==================================================
;2,早上起床（早安口上，约在她起床時間 8:00 触发）
;人设：露娜就寝=2:00、起床=8:00（三妖精里睡得最晚、起得最晚），不是昼夜颠倒，只是晚睡晚起。
;==================================================
@M_KOJO_EVENT_K6_2(ARG, ARG:1)
