	RETURN 0
;@AT 测试通过 K6_EV2_早安
IF TALENT:6:恋人
	PRINTFORMW 「唔……早上好……呼啊……昨晚又贪玩到快两点才睡，让我、让我再赖一小会儿嘛……」
ELSE
	PRINTFORMW （露娜顶着黑眼圈打了个大大的哈欠——三妖精里数她睡得最晚，这会儿还没完全睡醒。）
ENDIF
RETURN 1

;==================================================
;3,就寝相关（约在她就寝時間 2:00 前后触发）
;ARG 2=就寝前还不肯睡（她睡得最晚）  3=已入睡（深夜2点后）
;==================================================
@M_KOJO_EVENT_K6_3(ARG, ARG:1)
SIF CFLAG:6:現在位置 != CFLAG:MASTER:現在位置
	RETURN 0
SELECTCASE ARG
	CASE 2
		;就寝前还精神——三妖精里她撑得最晚
		;@AT 测试通过 K6_EV3_装困
		PRINTFORMW 「困？才、才没有呢。都快两点了还硬撑着不睡的，三妖精里可只有我一个哦……哼，很厉害吧。」
		RETURN 1
	CASE 3
		;已入睡——熬到两点才睡下
		;@AT 测试通过 K6_EV3_补觉
		PRINTFORMW （好不容易熬到两点，露娜才蜷进铺满黑白蕾丝的被窝，这会儿睡得正香。）
		RETURN 1
ENDSELECT
RETURN 1
;==================================================
;4,移動時すれちがい（主角用移动命令路过露娜所在中継格、不落脚）
;ARG 由玩家菜单选择决定：1=停下(随后转EVENT_1常规遭遇) / 2=打招呼路过 / 3=无视路过。
;⚠绝不要写同格守卫(現在位置!=MASTER)！ARG 2/3 时主角在移动、并不同格，加了会整段吞掉。
;引擎不读本事件返回值，RETURN 0 即可。派发源 COMF400 移動.ERB:411/417/419。
;“和别人约会”判定：CHK_DATENOW(CFLAG:MASTER:约会中) && FLAG:约会的对象 != TARGET && FLAG:约会的对象 != 0
;==================================================
@M_KOJO_EVENT_K6_4(ARG, ARG:1)
;口上主是 TARGET(露娜6)
LOCAL = 1
IF LOCAL
	IF ARG == 1
		;停下→随后 EVENT_1 接管常规遭遇，这里只出极短过场
		;@AT 待手动测试 K6_EV4_停下
		SIF K6_MT_ON()
		PRINTL [[MT K6_EV4_停下]]
		PRINTFORMW （露娜察觉到%CALLNAME:MASTER%停下了脚步，歪了歪头。）
		RETURN 0
	ELSEIF ARG == 2
		;打招呼路过
		IF CHK_DATENOW(CFLAG:MASTER:约会中) && FLAG:约会的对象 != TARGET && FLAG:约会的对象 != 0
			;带着别人、只是打个招呼路过
			;@AT 待手动测试 K6_EV4_打招呼_带别人
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV4_打招呼_带别人]]
			PRINTFORMW 「哦……你好呀。哼，带着别人呢，那我就不打扰啦。」（露娜别过脸，把话音消掉了小半。）
		ELSEIF TALENT:6:恋人
			;@AT 待手动测试 K6_EV4_打招呼_恋人
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV4_打招呼_恋人]]
			PRINTFORMW 「呀，%CALLNAME:MASTER%！……只是路过？哼，那下次可要停下来陪我说会儿话哦。」
		ELSEIF TALENT:6:恋慕
			;@AT 待手动测试 K6_EV4_打招呼_恋慕
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV4_打招呼_恋慕]]
			PRINTFORMW 「啊，是你……嗯、嗯，路上小心。才、才不是舍不得你走呢。」
		ELSEIF TALENT:6:思慕 || CFLAG:6:好感度 >= 500
			;@AT 测试通过 K6_EV4_打招呼_思慕
			PRINTFORMW 「哟，是%CALLNAME:MASTER%。……嗯，你去忙吧。」
		ELSE
			;@AT 待手动测试 K6_EV4_打招呼_中立
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV4_打招呼_中立]]
			PRINTFORMW （露娜朝%CALLNAME:MASTER%轻轻点了下头，就继续做自己的事去了。）
		ENDIF
		RETURN 0
	ELSEIF ARG == 3
		;无视路过
		IF CHK_DATENOW(CFLAG:MASTER:约会中) && FLAG:约会的对象 != TARGET && FLAG:约会的对象 != 0
			;被无视、又见你带着别人
			;@AT 待手动测试 K6_EV4_无视_带别人
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV4_无视_带别人]]
			PRINTFORMW （露娜瞥见%CALLNAME:MASTER%带着别人径直走过、没理她，便把到嘴边的话连声音一起消掉了。）
		ELSEIF TALENT:6:恋人
			;@AT 待手动测试 K6_EV4_无视_恋人
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV4_无视_恋人]]
			PRINTFORMW 「诶……就这么走过去了？喂、喂！……哼，晚上可要好好补偿我。」
		ELSEIF TALENT:6:恋慕
			;@AT 待手动测试 K6_EV4_无视_恋慕
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV4_无视_恋慕]]
			PRINTFORMW 「……看都不看我一眼就走了。哼，无、无所谓啦，反正我也很忙的。」
		ELSEIF TALENT:6:思慕 || CFLAG:6:好感度 >= 500
			;@AT 测试通过 K6_EV4_无视_思慕
			PRINTFORMW 「唔，急着赶路啊……也不打声招呼。真是的。」
		ELSE
			;@AT 待手动测试 K6_EV4_无视_中立
			SIF K6_MT_ON()
			PRINTL [[MT K6_EV4_无视_中立]]
			PRINTFORMW （%CALLNAME:MASTER%没停留就走了过去。露娜「哼」了一声，当作没看见。）
		ENDIF
		RETURN 0
	ENDIF
ENDIF
RETURN 0


