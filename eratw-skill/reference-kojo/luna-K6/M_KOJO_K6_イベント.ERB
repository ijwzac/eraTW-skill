;※※※※※※※※※※※※※※※※※※※※※※※※※※
;"EVENT" 系事件
;※※※※※※※※※※※※※※※※※※※※※※※※※※
;==================================================
;1,房间/同格遭遇
;必须先做同格守卫：她不在你格子里就返回，否则每次她换格都会念
;ARG 1=你进来 2=她进来 3-5=浴室 6=外出遭遇 7=约会中被撞见 8=当日第一次问候 9=外出当日第一次问候(ARG:1=约会对象)
;==================================================
@M_KOJO_EVENT_K6_1(ARG, ARG:1)
;★同格守卫（SKILL pitfall #4）
SIF CFLAG:6:現在位置 != CFLAG:MASTER:現在位置
	RETURN 0
SELECTCASE ARG
	CASE 8
		;当日第一次问候（之后会接到 1 或 2）
		TCVAR:6:350 = 1
		IF TALENT:6:恋人
			PRINTFORMW 「早……啊，不对，现在是白天啊。唔，晚上好？总之——%CALLNAME:MASTER%，你来啦。」
		ELSE
			PRINTFORMW 「唔……又是你。哼，我可没有在等你哦。」
		ENDIF
		RETURN 1
	CASE 1
		;你进来了
		IF TALENT:6:恋人
			PRINTFORML 「呀，%CALLNAME:MASTER%！」
			PRINTFORMW （露娜把周围的声音一收，凑过来小声说：「这样别人就听不到我们说话了……嘿嘿。」）
		ELSEIF TALENT:6:恋慕
			PRINTFORML 「……进、进来之前敲门啊笨蛋！吓我一跳……」
			PRINTFORMW （她慌慌张张把手里的东西藏到背后，像是刚才在偷偷摆弄什么。）
		ELSE
			PRINTFORMW 「……哼，人类的房间也没什么好看的嘛。我只是路过。」
		ENDIF
		RETURN 1
	CASE 2
		;她进来了
		IF TALENT:6:恋人
			PRINTFORMW 「打扰啦——诶嘿，其实是想你了才来的。这种话，只有把声音消掉才敢说呢。」
		ELSE
			PRINTFORMW （露娜蹑手蹑脚地溜了进来，脚步没有一点声音，却在门槛上绊了个趔趄。）
		ENDIF
		RETURN 1
	CASE 6
		;外出遭遇
		PRINTFORML 「唔哇，是%CALLNAME:MASTER%……大白天的，晃得我眼睛疼。」
		PRINTFORMW 「我可是夜里才有精神的。白天遇到，就当没看见吧，互相的。」
		RETURN 1
	CASE 7
		;约会中被撞见（ARG:1=约会对象）
		PRINTFORML 「诶……%CALLNAME:MASTER%在跟别人约会？」
		PRINTFORMW （露娜张了张嘴想抱怨点什么，最后只是把周围的声音消掉，扭头飞走了。）
		RETURN 1
	CASE 9
		;外出当日第一次问候
		TCVAR:6:350 = 1
		IF ARG:1
			PRINTFORMW 「……在跟别人约会？哼，随便你啦。」
		ELSE
			PRINTFORMW 「白天出门……真稀奇。我？我只是在找掉下来的月亮碎片啦。」
		ENDIF
		RETURN 1
ENDSELECT
RETURN 1

;==================================================
;2,早上起床（早安口上）——夜之妖精的早晨最难熬
;==================================================
@M_KOJO_EVENT_K6_2(ARG, ARG:1)
SIF CFLAG:6:現在位置 != CFLAG:MASTER:現在位置
	RETURN 0
IF TALENT:6:恋人
	PRINTFORMW 「唔……早上好……呼啊……让我再、再靠一会儿……夜里根本睡不着，白天才是我的深夜啊……」
ELSE
	PRINTFORMW （露娜顶着一对黑眼圈，睡眼惺忪地打了个大大的哈欠。看来又是一夜没睡。）
ENDIF
RETURN 1

;==================================================
;3,夜里睡觉（晚安口上）——因夜失眠：夜里她精神得很
;==================================================
@M_KOJO_EVENT_K6_3(ARG, ARG:1)
SIF CFLAG:6:現在位置 != CFLAG:MASTER:現在位置
	RETURN 0
SELECTCASE ARG
	CASE 2
		;显得困倦——她才不困
		PRINTFORMW 「困？我才不困呢。夜里正是妖精最精神的时候……人类快去睡你的吧。」
		RETURN 1
	CASE 3
		;睡眠中——白天补觉
		PRINTFORMW （露娜蜷在铺满黑白蕾丝的床上，白天睡得正香。月光妖精的作息，果然和人类是反的。）
		RETURN 1
ENDSELECT
RETURN 1

