TFLAG:192 = 0

@M_KOJO_MESSAGE_COM_K6_312
CALL TRAIN_MESSAGE
CALL M_KOJO_MESSAGE_COM_K6_312_1
RETURN RESULT

@M_KOJO_MESSAGE_COM_K6_312_1
LOCAL = 1
IF LOCAL
	IF FLAG:時間停止
	ELSEIF TALENT:6:恋人
		PRINTFORML 「唔……♥ 这一下，连月光都要嫉妒了呢。」
		PRINTFORMW （露娜意犹未尽地眨了眨那双红色的眼睛。）
		CALL ADD_KISS
		CALL AddEXP("接吻経験", 6, 5)
	ELSEIF TALENT:6:恋慕
		PRINTFORML 「诶——！？亲、亲上来了……！这、这种事要先说一声啊笨蛋！」
		PRINTFORMW （一向迟钝的露娜，这次反应倒是快得出奇，只是快在了脸红上。）
		CALL ADD_KISS
		CALL AddEXP("接吻経験", 6, 3)
	ELSE
		PRINTFORML 「唔哇——！你、你干什么！」
		PRINTFORMW （露娜猛地后退，一如既往地被自己的脚绊倒，一屁股坐在了地上。）
	ENDIF
ENDIF
RETURN 1

